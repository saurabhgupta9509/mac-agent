<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>DLP Security Agent</title>
    
    <!-- Custom Branded Wizard Configuration -->
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    
    <!-- System Requirement: macOS 12.0 (Monterey) or higher -->
    <options customize="never" require-scripts="false" hostArchitectures="x86_64,arm64" rootVolumeOnly="true"/>
    
    <volume-check>
        <allowed-os-versions>
            <os-version min="12.0"/>
        </allowed-os-versions>
    </volume-check>
    
    <!-- Component Outline -->
    <choices-outline>
        <line choice="choiceCore"/>
    </choices-outline>
    
    <choice id="choiceCore" title="DLP Agent Core Service" description="Installs the core DLP daemon, LaunchDaemons, and background security modules." visible="false">
        <pkg-ref id="com.dlpagent.core"/>
    </choice>
    
    <pkg-ref id="com.dlpagent.core" version="1.0.0" onConclusion="none">core.pkg</pkg-ref>
</installer-gui-script>
