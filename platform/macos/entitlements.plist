<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  entitlements.plist — Required entitlements for DLP Agent
  
  These replace Windows DACL + privilege levels.
  Must be submitted to Apple for approval (System Extension entitlements).
  
  Reference: https://developer.apple.com/documentation/bundleresources/entitlements
-->
<plist version="1.0">
<dict>
    <!-- ── System Extension (Network Filter + Endpoint Security) ── -->
    <key>com.apple.security.system-extension</key>
    <true/>

    <!-- ── Network Extension (replaces WFP driver) ── -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>com.apple.developer.networking.networkextension</key>
    <array>
        <string>content-filter-provider</string>
        <string>dns-proxy</string>
        <string>packet-tunnel-provider</string>
    </array>

    <!-- ── Endpoint Security (replaces kernel file filter) ── -->
    <key>com.apple.security.endpoint-security.client</key>
    <true/>

    <!-- ── App Groups (IPC between daemon and UI helper) ── -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>com.dlpagent.shared</string>
    </array>

    <!-- ── Hardened Runtime options ── -->
    <key>com.apple.security.hardened-runtime</key>
    <true/>

    <!-- Allow JIT for ONNX/ML inference -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow dyld environment variables (needed for some crates) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>

    <!-- ── Screen Recording (for security monitor OCR) ── -->
    <key>com.apple.security.screen-recording</key>
    <true/>

    <!-- ── Keychain access ── -->
    <key>keychain-access-groups</key>
    <array>
        <string>com.dlpagent.credentials</string>
    </array>
</dict>
</plist>
